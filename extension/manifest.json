{
  "manifest_version": 3,
  "name": "GIF nos Comentários do YouTube",
  "version": "1.8.8",
  "description": "Insere GIFs nos comentários de vídeos e Shorts; miniatura inline ao escrever e imagem maior após publicar, sem chave de API.",
  "permissions": [],
  "host_permissions": [
    "https://api.giphy.com/*",
    "https://giphy.com/*",
    "https://*.giphy.com/*",
    "https://media.tenor.com/*",
    "https://c.tenor.com/*",
    "https://tenor.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GIFs nos comentários do YouTube"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
